# ── EchoAlert Backend — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in the real values.
# NEVER commit .env — it is listed in .gitignore.

# ── Database (PostgreSQL required for Railway deployment) ─────────────────────
# Railway provides this automatically when you attach a Postgres plugin.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://user:password@localhost:5432/sos_algerie

# (Optional) Admin/maintenance DB used by db_init.py to CREATE the app database.
# Only needed if you run db_init.py manually. Defaults to DATABASE_URL if unset.
DATABASE_ADMIN_URL=postgresql://user:password@localhost:5432/postgres

# ── JWT / Auth ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of allowed origins. In production set to your Railway dashboard URL.
# Example: ["https://my-dashboard.railway.app"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# Use a Gmail App Password (not your account password):
# https://support.google.com/accounts/answer/185833
SMTP_PASSWORD=your-app-password
ADMIN_EMAIL=admin@your-domain.com

# ── Scheduler ─────────────────────────────────────────────────────────────────
# How many days before expiry to start sending license warnings.
LICENSE_WARNING_DAYS=30

# ── Firebase / FCM (push notifications) ──────────────────────────────────────
# Option 1 — RAILWAY / PRODUCTION (recommended):
#   Paste the entire service-account JSON as a single-line string.
#   Get it: Firebase Console → Project Settings → Service Accounts → Generate new private key.
#   Collapse to one line: python -c "import json,sys; print(json.dumps(json.load(sys.stdin)))" < key.json
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@YOUR_PROJECT.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Option 2 — LOCAL DEV FALLBACK (file on disk, only used if FIREBASE_CREDENTIALS_JSON is not set):
# FIREBASE_CREDENTIALS_PATH=/path/to/serviceAccountKey.json

# Option 3 — IMPLICIT ADC (leave both above unset; firebase_admin uses GOOGLE_APPLICATION_CREDENTIALS):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json
